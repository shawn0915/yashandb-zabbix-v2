# YashanDB Zabbix Agent UserParameter 配置示例
# 文件位置: /etc/zabbix/zabbix_agentd.d/yashandb.conf
# 或 Windows: C:\Program Files\Zabbix Agent 2\zabbix_agentd.d\yashandb.conf
#
# 注意：请勿将此文件提交到 Git（已在 .gitignore 中排除加密版本）
# 敏感配置请使用 yashandb_<instance>.conf 命名，.gitignore 已忽略该格式
#
# ================================================================
# v2.0 指标命名规范：
#   yashandb.db.*  — 原生监控指标（v1.0 兼容）
#   yashandb.*     — Datadog Oracle 兼容指标
#   yashandb.tablespace.* — 表空间指标（含 LLD 自动发现）
#
# 推荐使用配置文件方式（避免密码明文），见文件末尾
# ================================================================

# ----------------------------------------------------------------
# 方式一：每个指标单独一行 UserParameter（示例行，取消注释即可使用）
# ----------------------------------------------------------------
### Linux 示例 ###
# SCRIPT_DIR=/etc/zabbix/scripts/yas_zabbix
# PYTHON_BIN=/usr/bin/python3

### 实例状态（原生） ###
#UserParameter=yashandb.db.status,/usr/bin/python3 /etc/zabbix/scripts/yas_zabbix/yashandb_monitor.py --host 127.0.0.1 --port 1688 --user sys --password "YourPassword" --metric yashandb.db.status
#UserParameter=yashandb.db.version,/usr/bin/python3 /etc/zabbix/scripts/yas_zabbix/yashandb_monitor.py --host 127.0.0.1 --port 1688 --user sys --password "YourPassword" --metric yashandb.db.version
#UserParameter=yashandb.db.uptime,/usr/bin/python3 /etc/zabbix/scripts/yas_zabbix/yashandb_monitor.py --host 127.0.0.1 --port 1688 --user sys --password "YourPassword" --metric yashandb.db.uptime
#UserParameter=yashandb.db.mode,/usr/bin/python3 /etc/zabbix/scripts/yas_zabbix/yashandb_monitor.py --host 127.0.0.1 --port 1688 --user sys --password "YourPassword" --metric yashandb.db.mode

