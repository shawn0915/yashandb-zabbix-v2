### Windows 示例（Zabbix Agent 2）###
#UserParameter=yashandb.db.status,C:\Python3\python.exe C:\zabbix\scripts\yas_zabbix\yashandb_monitor.py --host 127.0.0.1 --port 1688 --user sys --password YourPassword --metric yashandb.db.status

# ----------------------------------------------------------------
# 方式二：使用配置文件（推荐生产环境，避免密码明文在配置中暴露）
# ----------------------------------------------------------------
# 创建 /etc/zabbix/scripts/yas_zabbix/config/yashandb.conf（已在 .gitignore 排除）
# 内容格式：
#   [yashandb]
#   host = 127.0.0.1
#   port = 1688
#   user = sys
#   password = YourPassword
#
# 然后所有 UserParameter 使用 --config 参数（密码用 x 占位）：
#UserParameter=yashandb.db.status,/usr/bin/python3 /etc/zabbix/scripts/yas_zabbix/yashandb_monitor.py --config /etc/zabbix/scripts/yas_zabbix/config/yashandb.conf --host x --user x --password x --metric yashandb.db.status
